{
   "author": "marvin",
   "background": {
      "service_worker": "sw.js"
   },
   "action": {
      "default_icon": "goateq128.png",
      "default_popup": "popup.html"
   },
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "description": "Gain Optimization & Audio Treatment for your browser. EQ any audio you find on the web, live!",
   "icons": {
      "128": "goateq128.png",
      "16": "goateq16.png",
      "32": "goateq32.png",
      "48": "goateq48.png",
      "64": "goateq64.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "goatEQ: Gain Optimization & Audio Treatment",
   "permissions": [ "activeTab", "tabCapture", "tabs", "storage", "offscreen" ],
   "short_name": "goatEQ",
   "version": "1.0.0"
}
