{
  "manifest_version": 3,
  "name": "goatEQ: Gain Optimization & Audio Treatment",
  "short_name": "goatEQ",
  "version": "2.1.2",
  "author": "mleem97 / marvin lee meyer",
  "homepage_url": "https://github.com/mleem97/goatEQ",
  "description": "Real-time browser equalizer and mastering chain with spectral before/after monitoring.",
  "action": { "default_icon": "goateq128.png", "default_popup": "index.html" },
  "background": { "service_worker": "service-worker.js" },
  "icons": { "16": "goateq16.png", "32": "goateq32.png", "48": "goateq48.png", "64": "goateq64.png", "128": "goateq128.png" },
  "permissions": ["activeTab", "tabCapture", "tabs", "storage", "offscreen"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
