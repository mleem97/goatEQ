{
  "manifest_version": 3,
  "name": "goatEQ: Gain Optimization & Audio Treatment",
  "short_name": "goatEQ",
  "version": "1.0.0",
  "author": "marvin",
  "description": "Gain Optimization & Audio Treatment for your browser. EQ any audio you find on the web, live!",
  "action": {
    "default_icon": "goateq128.png",
    "default_popup": "index.html"
  },
  "icons": {
    "16": "goateq16.png",
    "32": "goateq32.png",
    "48": "goateq48.png",
    "64": "goateq64.png",
    "128": "goateq128.png"
  },
  "background": {
    "service_worker": "chromium/sw.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "tabCapture",
    "tabs",
    "storage",
    "offscreen"
  ]
}
